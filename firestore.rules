rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToWorkspace(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function ownsWorkspace(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function canUseWorkspace(workspaceId) {
      return belongsToWorkspace(workspaceId) || ownsWorkspace(workspaceId);
    }

    function isIncompleteOwnerProvisioning(workspaceId) {
      return ownsWorkspace(workspaceId)
        && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function currentDataPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/data/current;
    }

    function isNormalizedWorkspaceData(data) {
      return data.keys().hasOnly([
          'storageVersion', 'schemaVersion', 'revision', 'pace', 'sprite', 'updatedAt'
        ])
        && data.keys().hasAll([
          'storageVersion', 'schemaVersion', 'revision', 'pace'
        ])
        && data.storageVersion == 1
        && data.schemaVersion == 2
        && data.revision is int
        && data.revision >= 0
        && data.get('updatedAt', request.time) is timestamp
        && (data.pace == 'light' || data.pace == 'steady' || data.pace == 'full')
        && (
          data.get('sprite', 'code-squire') == 'code-squire'
          || data.get('sprite', 'code-squire') == 'diverse-squire'
          || data.get('sprite', 'code-squire') == 'girl-squire'
          || data.get('sprite', 'code-squire') == 'asian-squire'
          || data.get('sprite', 'code-squire') == 'ambiguous-squire'
        );
    }

    function isNormalizedProject(data, projectId) {
      return data.keys().hasOnly([
          'id', 'title', 'code', 'outcome', 'color', 'targetDate', 'position', 'revision'
        ])
        && data.keys().hasAll([
          'id', 'title', 'code', 'outcome', 'color', 'targetDate', 'position', 'revision'
        ])
        && data.id == projectId
        && data.title is string
        && data.code is string
        && data.outcome is string
        && data.targetDate is string
        && data.position is int
        && data.position >= 0
        && data.revision is int
        && (data.color == 'clay' || data.color == 'moss' || data.color == 'slate');
    }

    function isNormalizedTask(workspaceId, data, taskId) {
      return data.keys().hasOnly([
          'id', 'title', 'projectId', 'status', 'weight', 'meaning', 'assignee',
          'isFocus', 'createdAt', 'completedAt', 'description', 'priority',
          'dueDate', 'revision'
        ])
        && data.keys().hasAll([
          'id', 'title', 'projectId', 'status', 'weight', 'meaning', 'assignee',
          'isFocus', 'createdAt', 'revision'
        ])
        && data.id == taskId
        && data.title is string
        && data.title.size() > 0
        && data.projectId is string
        && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.projectId))
        && data.status in ['ready', 'moving', 'paused', 'done']
        && data.weight is int
        && data.weight >= 1
        && data.weight <= 3
        && data.meaning is string
        && data.assignee is string
        && data.isFocus is bool
        && data.createdAt is string
        && data.get('completedAt', '') is string
        && data.get('description', '') is string
        && data.get('priority', '') in ['', 'low', 'medium', 'high']
        && data.get('dueDate', '') is string
        && (data.status != 'done' || data.get('completedAt', '').size() > 0)
        && data.revision is int;
    }

    function startsNormalizedWorkspace(workspaceId) {
      return !exists(currentDataPath(workspaceId))
        && isNormalizedWorkspaceData(getAfter(currentDataPath(workspaceId)).data)
        && getAfter(currentDataPath(workspaceId)).data.revision == 0;
    }

    function advancesWorkspaceRevision(workspaceId) {
      return exists(currentDataPath(workspaceId))
        && isNormalizedWorkspaceData(getAfter(currentDataPath(workspaceId)).data)
        && getAfter(currentDataPath(workspaceId)).data.revision
          == get(currentDataPath(workspaceId)).data.get('revision', 0) + 1;
    }

    function isNewGuildId(workspaceId) {
      // New roots use a namespaced UUID v4. Existing uid-keyed/legacy roots
      // remain readable and updatable, but can no longer be created by a
      // different signed-in account claiming that path first.
      return workspaceId.matches('guild-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
    }

    function hasInviteForCurrentUser(workspaceId, inviteEmail) {
      return signedIn()
        && request.auth.token.email != null
        && inviteEmail == request.auth.token.email
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(inviteEmail));
    }

    // Authoritative, server-clock expiry check. Only call after confirming the
    // invite exists (get() on a missing doc errors). Invites written before the
    // expiry field existed default to far-future so they stay acceptable.
    function inviteNotExpired(workspaceId, inviteEmail) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(inviteEmail))
        .data.get('expiresAt', request.time + duration.value(3650, 'd')) > request.time;
    }

    // TICKET-031 (simplified per maintainer decision): any signed-in account may
    // self-join this one specific, publicly-shared cohort guild with no invite
    // and no eligibility allowlist. Scoped to a single literal workspace id so
    // every other guild keeps its normal invite-only boundary untouched.
    function isOpenCohortGuild(workspaceId) {
      return workspaceId == 'guild-7ea24403-64f6-424c-b2d7-0d7e44209492';
    }

    // A signed-in person may discover only member documents whose UID is
    // their own. This powers the guild switcher without exposing rosters
    // from unrelated workspaces through a collection-group query.
    match /{document=**}/members/{memberId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A signed-in person may discover only invitations addressed to their own
    // authenticated email. This powers the in-app pending-invitations panel
    // without exposing other people's invites through a collection-group query.
    match /{document=**}/invites/{inviteEmail} {
      allow get, list: if signedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
    }

    match /workspaces/{workspaceId} {
      // A signed-in person may always read the workspace whose id equals their
      // own uid (their default guild). This lets first-run provisioning check
      // for existence before creating it, without exposing anyone else's data
      // because no other account can hold that document id.
      allow read: if belongsToWorkspace(workspaceId)
        || ownsWorkspace(workspaceId)
        || (signedIn() && workspaceId == request.auth.uid);
      allow create: if signedIn()
        && isNewGuildId(workspaceId)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsWorkspace(workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if ownsWorkspace(workspaceId);

      match /members/{memberId} {
        allow get, list: if belongsToWorkspace(workspaceId)
          || ownsWorkspace(workspaceId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if ownsWorkspace(workspaceId)
          || (signedIn()
            && memberId == request.auth.uid
            && request.auth.token.email != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == "member"
            && hasInviteForCurrentUser(workspaceId, request.auth.token.email)
            && inviteNotExpired(workspaceId, request.auth.token.email)
            && !existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.auth.token.email)))
          || (isOpenCohortGuild(workspaceId)
            && signedIn()
            && memberId == request.auth.uid
            && request.auth.token.email != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == "member");
        allow update, delete: if ownsWorkspace(workspaceId);
      }

      match /invites/{inviteEmail} {
        allow get, list: if ownsWorkspace(workspaceId)
          || hasInviteForCurrentUser(workspaceId, inviteEmail);
        allow create, update: if ownsWorkspace(workspaceId);
        allow delete: if ownsWorkspace(workspaceId)
          || hasInviteForCurrentUser(workspaceId, inviteEmail);
      }

      match /data/current {
        allow read: if canUseWorkspace(workspaceId);
        // Legacy whole-state documents remain readable so the first current
        // client save can migrate them. New clients create normalized metadata.
        allow create: if canUseWorkspace(workspaceId)
          && ((isNormalizedWorkspaceData(request.resource.data)
            && request.resource.data.revision == 0)
            || request.resource.data.get('state', null) != null);
        // Every current client write advances exactly one revision. Legacy
        // clients that still attempt blind whole-document updates fail closed.
        allow update: if canUseWorkspace(workspaceId)
          && isNormalizedWorkspaceData(request.resource.data)
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
        allow delete: if isIncompleteOwnerProvisioning(workspaceId);
      }

      match /projects/{projectId} {
        allow read: if canUseWorkspace(workspaceId);
        allow create, update: if canUseWorkspace(workspaceId)
          && isNormalizedProject(request.resource.data, projectId)
          && request.resource.data.revision == getAfter(currentDataPath(workspaceId)).data.revision
          && (startsNormalizedWorkspace(workspaceId) || advancesWorkspaceRevision(workspaceId));
        allow delete: if isIncompleteOwnerProvisioning(workspaceId)
          || (canUseWorkspace(workspaceId) && advancesWorkspaceRevision(workspaceId));
      }

      match /tasks/{taskId} {
        allow read: if canUseWorkspace(workspaceId);
        allow create, update: if canUseWorkspace(workspaceId)
          && isNormalizedTask(workspaceId, request.resource.data, taskId)
          && request.resource.data.revision == getAfter(currentDataPath(workspaceId)).data.revision
          && (startsNormalizedWorkspace(workspaceId) || advancesWorkspaceRevision(workspaceId));
        allow delete: if isIncompleteOwnerProvisioning(workspaceId)
          || (canUseWorkspace(workspaceId) && advancesWorkspaceRevision(workspaceId));
      }

      match /recovery/{recoveryId} {
        allow read: if canUseWorkspace(workspaceId);
        // The first normalized save may create one immutable recovery point
        // from the legacy whole-state document. It cannot be edited or erased
        // from the browser afterward.
        allow create: if recoveryId == 'legacy-v2'
          && canUseWorkspace(workspaceId)
          && request.resource.data.keys().hasOnly([
            'state', 'sourceStorageVersion', 'migratedAt'
          ])
          && request.resource.data.keys().hasAll([
            'state', 'sourceStorageVersion', 'migratedAt'
          ])
          && request.resource.data.get('sourceStorageVersion', '') == 'whole-state-v2'
          && request.resource.data.state is map
          && request.resource.data.migratedAt is timestamp
          && get(currentDataPath(workspaceId)).data.get('storageVersion', 0) != 1
          && advancesWorkspaceRevision(workspaceId);
        allow update, delete: if false;
      }
    }
  }
}
